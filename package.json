{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && next build",
    "build:vercel": "prisma generate && next build",
    "db:migrate": "prisma migrate deploy",
    "build:prisma": "prisma generate || echo 'Prisma generation skipped'",
    "build:with-prisma": "npm run build:prisma && next build",
    "dev": "next dev",
    "lint": "next lint",
    "start": "next start",
    "test": "vitest",
    "test:release": "vitest run src/modules/simulator src/modules/price-data app/api app/simulation/__tests__/PowerLawModel.enhanced.test.ts app/simulation/price-models/models/__tests__/EnhancedCycleRepeatModel.test.ts app/simulation/price-models/models/__tests__/cycle-replay-contract.test.ts app/simulation/price-models/models/__tests__/scenario-metrics.test.ts app/simulation/tabs/price-projection/cycle-repeat/DiminishingReturnsControls.test.tsx src/modules/strategies/services/__tests__/rolling-calendar.test.ts app/simulation/research app/simulation/tabs/parameters/__tests__/LoanCostMetrics.test.ts",
    "test:ui": "vitest --ui",
    "test:modules": "vitest src/modules",
    "test:agent-os": "vitest __tests__/agent-os",
    "type-check": "tsc --noEmit",
    "db:seed": "tsx scripts/backfill-and-seed-prices.ts",
    "db:reset": "prisma migrate reset --force && pnpm db:seed",
    "postinstall": "prisma generate || echo 'Prisma generation skipped'"
  },
  "prisma": {
    "seed": "tsx scripts/backfill-and-seed-prices.ts"
  },
