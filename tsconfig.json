{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "types": ["vitest/globals"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./"],
      "@/components/*": ["./src/components/*"],
      "@/lib/*": ["./lib/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/modules/*": ["./src/modules/*"],
      "@/shared/*": ["./src/modules/shared/*"],
      "@/simulation/tabs/*": ["./app/simulation/tabs/*"],
      "@/simulation/shared/*": ["./app/simulation/shared/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    "examples-disabled",
    "questionsWT",
    "questionsWT/**/*",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/__tests__",
    "test-*.ts",
    "**/test-*.ts",
    "analyze-api-status.ts",
    "api-based-data-insert.ts",
    "debug-api-issues.ts",
    "final-verification.ts",
    "resume-gap-filling.ts"
  ]
}
