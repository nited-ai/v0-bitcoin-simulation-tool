# .env.example — committed; copy to .env.local and fill in for local dev
#
# For Option D (no local Docker): pull from Vercel after provisioning Postgres:
#   pnpm dlx vercel env pull .env.local
#
# That command writes the real DATABASE_URL and other secrets into .env.local
# (which is gitignored). DO NOT commit .env.local.

# === Database ===
# Local dev: pulled from Vercel via `vercel env pull` after Vercel Postgres is provisioned.
# Format: postgresql://USER:PASS@HOST/DB?sslmode=require
DATABASE_URL=""

# === Cron auth (PR2 introduces, can be empty for PR1) ===
CRON_SECRET=""

# === External price provider keys (PR2 introduces real use) ===
# In PR1 these are unused; populate before PR2 deploys.
COINCAP_API_KEY=""
COINDESK_API_KEY=""
COINMARKETCAP_API_KEY=""
MESSARI_API_KEY=""
